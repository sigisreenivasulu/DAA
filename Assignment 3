def mitm(arr,T):
    n=len(arr);h=n//2;L=arr[:h];R=arr[h:]
    def subs(x):
        s=[0]
        for v in x:s+= [t+v for t in s]
        return s
    SL=subs(L);SR=sorted(subs(R));import bisect
    for s in SL:
        i=bisect.bisect_left(SR,T-s)
        if i<len(SR) and SR[i]==T-s:return True,len(SL)+len(SR)
    return False,len(SL)+len(SR)
