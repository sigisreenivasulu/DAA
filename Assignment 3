    u=[bs(a,x+1) for x in random.sample(a,min(n,2000))]
    print(n,round(sum(s)/len(s),2),max(s),round(sum(u)/len(u),2),int(math.log2(n))+1)
# Q2
def qs(a):
    st={'cmp':0,'maxd':0,'parts':[]}
    def rec(l,h,d):
        if l>=h: return
        st['maxd']=max(st['maxd'],d)
        p=a[l];i=l+1
        for j in range(l+1,h+1):
            st['cmp']+=1
            if a[j]<p:
                a[i],a[j]=a[j],a[i];i+=1
        a[l],a[i-1]=a[i-1],a[l]
        k=i-1
        if d==0: st['parts'].append((k-l,h-k))
        rec(l,k-1,d+1);rec(k+1,h,d+1)
    rec(0,len(a)-1,0);return st
def ms(a):
    st={'cmp':0,'maxd':0}
    def rec(x,d):
        st['maxd']=max(st['maxd'],d)
        if len(x)<=1:return x
        m=len(x)//2;L=rec(x[:m],d+1);R=rec(x[m:],d+1);o=[];i=j=0
        while i<len(L) and j<len(R):
            st['cmp']+=1
            if L[i]<=R[j]:o.append(L[i]);i+=1
            else:o.append(R[j]);j+=1
        return o+L[i:]+R[j:]
    rec(a,0);return st
print("Q2 n | QS-random cmp,depth | QS-sorted cmp,depth,firstsplit | QS-balanced(constructed) cmp,depth | MS cmp,depth")
def balanced(n):
    a=list(range(n))
    def b(l,h):
        if l>=h:return
        m=(l+h)//2
        a[l],a[m]=a[m],a[l]
        b(l+1,m);b(m+1,h)  # approximate: place median first
    # construct: median at front recursively
    def build(x):
        if len(x)<=1:return x[:]
        m=len(x)//2;return [x[m]]+build(x[:m])+build(x[m+1:])
    return build(a)
