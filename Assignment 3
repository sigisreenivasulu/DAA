    print(n,(r['cmp'],r['maxd']),(s['cmp'],s['maxd'],s['parts'][0]),(bb['cmp'],bb['maxd'],bb['parts'][0]),(m['cmp'],m['maxd']),"n(n-1)/2=",n*(n-1)//2,"nlog2n=",round(n*math.log2(n)))
# Q3
cnt=[0]
def school(x,y):
    a=list(map(int,str(x)))[::-1];b=list(map(int,str(y)))[::-1]
    r=[0]*(len(a)+len(b))
    for i,u in enumerate(a):
        for j,v in enumerate(b):
            r[i+j]+=u*v;cnt[0]+=1
    c=0
    for k in range(len(r)):
        t=r[k]+c;r[k]=t%10;c=t//10
    return int(''.join(map(str,r[::-1])))
def kara(x,y,n):
    if n<=1:
        cnt[0]+=1;return x*y
    m=n//2;p=10**m
    a,b=divmod(x,p);c,d=divmod(y,p)
    ac=kara(a,c,max(n-m,1));bd=kara(b,d,m)
    s=kara(a+b,c+d,n-m+1 if n-m+1<n else n)
    return ac*p*p+(s-ac-bd)*p+bd
# safer karatsuba
def kara2(x,y):
    if x<10 or y<10:
        cnt[0]+=1;return x*y
    n=max(len(str(x)),len(str(y)));m=n//2;p=10**m
    a,b=divmod(x,p);c,d=divmod(y,p)
    ac=kara2(a,c);bd=kara2(b,d);s=kara2(a+b,c+d)
    return ac*p*p+(s-ac-bd)*p+bd
