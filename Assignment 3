    assert abs(b-d)<1e-9
    print(n,bc,dc,round(tb,2),round(td,2))
# Q6
def qselect(a,k,mode):
    a=a[:];c=0
    while True:
        if len(a)==1:return a[0],c
        p=a[0] if mode=='first' else random.choice(a)
        lo=[x for x in a if x<p];eq=[x for x in a if x==p];hi=[x for x in a if x>p];c+=len(a)
        if k<len(lo):a=lo
        elif k<len(lo)+len(eq):return p,c
        else:k-=len(lo)+len(eq);a=hi
mcnt=[0]
def mom(a,k):
    if len(a)<=5:
        mcnt[0]+=len(a)*3;return sorted(a)[k]
    med=[sorted(a[i:i+5])[len(a[i:i+5])//2] for i in range(0,len(a),5)]
    mcnt[0]+=len(a)*1.2
    p=mom(med,len(med)//2)
    lo=[x for x in a if x<p];eq=[x for x in a if x==p];hi=[x for x in a if x>p];mcnt[0]+=len(a)
    if k<len(lo):return mom(lo,k)
    if k<len(lo)+len(eq):return p
    return mom(hi,k-len(lo)-len(eq))
