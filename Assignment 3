# Q5
def dist(a,b):
    return math.hypot(a[0]-b[0],a[1]-b[1])
def brute(P):
    c=0;best=1e18
    for i in range(len(P)):
        for j in range(i+1,len(P)):
            c+=1;best=min(best,dist(P[i],P[j]))
    return best,c
def cp(P):
    P=sorted(P);c=[0]
    def rec(Px):
        n=len(Px)
        if n<=3:
            b=1e18
            for i in range(n):
                for j in range(i+1,n):
                    c[0]+=1;b=min(b,dist(Px[i],Px[j]))
            return b,sorted(Px,key=lambda p:p[1])
        m=n//2;mx=Px[m][0]
        dl,L=rec(Px[:m]);dr,R=rec(Px[m:])
        d=min(dl,dr);Y=[];i=j=0
        while i<len(L) and j<len(R):
            if L[i][1]<=R[j][1]:Y.append(L[i]);i+=1
            else:Y.append(R[j]);j+=1
        Y+=L[i:]+R[j:]
        S=[p for p in Y if abs(p[0]-mx)<d]
        for i in range(len(S)):
            for j in range(i+1,len(S)):
                if S[j][1]-S[i][1]>=d:break
                c[0]+=1;d=min(d,dist(S[i],S[j]))
        return d,Y
    return rec(P)[0],c[0]
