    f,l=mitm(arr,T)
    if n<=20:
        bf=any(sum(x for i,x in enumerate(arr) if m>>i&1)==T for m in range(1<<n));assert bf==f
    print(n,2**n,l,f)
# Q7 inversions
def inv_dc(a):
    c=[0]
    def rec(x):
        if len(x)<=1:return x,0
        m=len(x)//2;L,a1=rec(x[:m]);R,a2=rec(x[m:]);o=[];i=j=0;t=a1+a2
        while i<len(L) and j<len(R):
            c[0]+=1
            if L[i]<=R[j]:o.append(L[i]);i+=1
            else:o.append(R[j]);j+=1;t+=len(L)-i
        return o+L[i:]+R[j:],t
    return rec(a)[0],c[0]
def inv_dc2(a):
    r,t=None,None
    c=[0]
    def rec(x):
        if len(x)<=1:return x,0
        m=len(x)//2;L,a1=rec(x[:m]);R,a2=rec(x[m:]);o=[];i=j=0;t=a1+a2
        while i<len(L) and j<len(R):
            c[0]+=1
            if L[i]<=R[j]:o.append(L[i]);i+=1
            else:o.append(R[j]);j+=1;t+=len(L)-i
        return o+L[i:]+R[j:],t
    return rec(a)[1],c[0]
def inv_bf(a):
    return sum(1 for i in range(len(a)) for j in range(i+1,len(a)) if a[i]>a[j]),len(a)*(len(a)-1)//2
