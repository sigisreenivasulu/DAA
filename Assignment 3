    a=[random.randint(0,10**6) for _ in range(n)];c=[0];r=mm(a,0,n-1,c)
    assert r==(max(a),min(a))
    print(n,c[0],math.ceil(3*n/2)-2 if n%2==0 else None,2*(n-1))
def bs(a,t):
    l,h,c=0,len(a)-1,0
    while l<=h:
        m=(l+h)//2;c+=1
        if a[m]==t: return c
        if a[m]<t:l=m+1
        else:h=m-1
    return c
