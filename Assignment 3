# Q1 maxmin
def mm(a,l,h,c):
    if l==h: return a[l],a[l]
    if h==l+1:
        c[0]+=1
        return (a[l],a[h]) if a[l]>a[h] else (a[h],a[l])
    m=(l+h)//2
    x=mm(a,l,m,c); y=mm(a,m+1,h,c)
    c[0]+=2
    return max(x[0],y[0]),min(x[1],y[1])
