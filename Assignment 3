# Q4
def madd(A,B,s=1):
    return [[A[i][j]+s*B[i][j] for j in range(len(A))] for i in range(len(A))]
mc=[0]
def conv(A,B):
    n=len(A);C=[[0]*n for _ in range(n)]
    for i in range(n):
        for k in range(n):
            a=A[i][k]
            for j in range(n):
                C[i][j]+=a*B[k][j]
    mc[0]+=n**3;return C
def strassen(A,B,cut):
    n=len(A)
    if n<=cut: return conv(A,B)
    h=n//2
    sub=lambda M,r,c:[row[c:c+h] for row in M[r:r+h]]
    A11,A12,A21,A22=sub(A,0,0),sub(A,0,h),sub(A,h,0),sub(A,h,h)
    B11,B12,B21,B22=sub(B,0,0),sub(B,0,h),sub(B,h,0),sub(B,h,h)
    M1=strassen(madd(A11,A22),madd(B11,B22),cut)
    M2=strassen(madd(A21,A22),B11,cut)
    M3=strassen(A11,madd(B12,B22,-1),cut)
    M4=strassen(A22,madd(B21,B11,-1),cut)
    M5=strassen(madd(A11,A12),B22,cut)
    M6=strassen(madd(A21,A11,-1),madd(B11,B12),cut)
    M7=strassen(madd(A12,A22,-1),madd(B21,B22),cut)
    C11=madd(madd(M1,M4),madd(M5,M7,-1),-1) if False else madd(madd(madd(M1,M4),M5,-1),M7)
    C12=madd(M3,M5);C21=madd(M2,M4)
    C22=madd(madd(madd(M1,M2,-1),M3),M6)
    return [C11[i]+C12[i] for i in range(h)]+[C21[i]+C22[i] for i in range(h)]
